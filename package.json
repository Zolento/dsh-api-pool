{
  "name": "dsh-api-pool",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-endpoint, quota-aware API pool for DeepSeek Harness: a selectable 'API Pool' provider with automatic key/endpoint failover and a settings page that manages the endpoints.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "RESEARCH.md",
    "RESULTS.md",
    "CHANGELOG.md",
    "dsh-compat.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "acceptance": "bash scripts/acceptance.sh",
    "check-dsh": "node scripts/check-dsh.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "license": "MIT"
}
